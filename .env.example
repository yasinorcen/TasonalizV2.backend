# Tasonaliz Backend Ortam Değişkenleri Örneği (.env.example)
# Gerçek .env dosyasını bu dosyayı kopyalayarak oluşturun ve Git'e EKLEMEYİN.

# Django Temel Ayarlar
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Veritabanı Yapılandırması
# Üretimde (Render / Railway / Yönetilen PostgreSQL) DATABASE_URL kullanılır.
# Yerel geliştirmede USE_SQLITE=True ise hızlı kurulum için SQLite kullanılır;
# PostgreSQL kullanmak için USE_SQLITE=False yapıp aşağıdaki bilgileri doldurun.
USE_SQLITE=True
DATABASE_URL=postgresql://postgres:password@localhost:5432/tasonaliz_db
DB_NAME=tasonaliz_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# CORS ve CSRF Güvenlik Ayarları (Frontend Adresleri)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Veri Kaynağı Önbellek Süresi (Saniye)
MARKET_CACHE_TTL_SECONDS=300
